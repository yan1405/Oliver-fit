# Oliver Fit — variáveis de ambiente
# Copie este arquivo para .env.local (Vite) e preencha com os valores reais.
# NUNCA commitar o .env.local ou qualquer valor real deste arquivo no git.

# Supabase — obtidos em Project Settings > API Keys depois de criar o projeto
# (criação do projeto é ação do usuário, não do agente)
# Desde a migração de chaves do Supabase, projetos novos mostram "Publishable key"
# (prefixo sb_publishable_...) em vez da antiga "anon key" — use o valor da
# Publishable key aqui; o supabase-js aceita os dois formatos sem diferença de uso.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth — client ID configurado no Google Cloud Console e
# habilitado como provedor no Supabase Auth
VITE_GOOGLE_CLIENT_ID=


# Web Push — chave pública VAPID (Fase 8), gerada com `npx web-push
# generate-vapid-keys`. A chave PRIVADA correspondente NUNCA entra aqui nem em
# nenhuma variável VITE_* — ela é embutida no bundle do cliente. A privada só
# vive como secret da Supabase Edge Function send-reminders (ver ORQUESTRACAO.md).
VITE_VAPID_PUBLIC_KEY=

# Ambiente (development | production)
VITE_APP_ENV=development
